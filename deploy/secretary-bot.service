# systemd unit for the Discord bot. Edit User and the paths, then:
#   sudo cp deploy/secretary-bot.service /etc/systemd/system/
#   sudo systemctl enable --now secretary-bot
[Unit]
Description=Secretary Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=secretary
WorkingDirectory=/home/secretary/Secretary
ExecStart=/home/secretary/Secretary/.venv/bin/python -m secretary.bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
