# Copy to .env (never commit .env). Used by the Discord bot and the CLI.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=            # your Discord user ID (Developer Mode > right-click your name > Copy User ID)
ANTHROPIC_API_KEY=

# Optional
SECRETARY_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 / claude-haiku-5-5 to lower cost
SECRETARY_EFFORT=medium           # low | medium | high
DISCORD_CHAT_CHANNEL_ID=          # a server channel where the bot answers without an @mention
DISCORD_NOTIFY_CHANNEL_ID=        # post reminders in this channel instead of DMs
SECRETARY_BOT_REMINDERS=1         # 0 = bot only chats; GitHub Actions sends reminders
DISCORD_WEBHOOK_URL=              # only for `python -m secretary tick --send webhook`
SECRETARY_GIT_SYNC=1              # 0 = don't pull/commit/push automatically
